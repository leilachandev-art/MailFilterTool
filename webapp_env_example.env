# 复制这个文件内容，改名/保存为 .env（本地测试用）
# 部署到 Render 时，把同样这些变量填到 Render 后台的 Environment 页面，不要把 .env 文件传上去。

SECRET_KEY=随便一串随机字符串，用来给登录会话加密

# ---- Zoho OAuth（在 https://api-console.zoho.com 注册 Server-based Application 拿到）----
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REDIRECT_URI=https://你的网站域名/auth/zoho/callback
ZOHO_SCOPE=ZohoMail.accounts.READ,ZohoMail.IMAP

# ---- Microsoft OAuth（在 https://portal.azure.com 注册"Web"平台的应用拿到）----
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MS_REDIRECT_URI=https://你的网站域名/auth/microsoft/callback

# ---- 数据库（不填就用本地 SQLite 文件，Render 上建议用免费的 Postgres，见 README）----
# DATABASE_URL=postgresql://user:password@host:5432/dbname
