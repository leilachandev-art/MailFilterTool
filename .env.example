# 复制这个文件内容，改名/保存为 .env（本地测试用）。
# 部署到 Render 时，把同样这些变量一个个填到 Render 后台的 Environment 页面，不要把 .env 文件传上去。

SECRET_KEY=换成一串随机字符串，用来给登录会话签名（本机生成：python -c "import secrets; print(secrets.token_hex(32))"）

# 落库前加密 refresh_token 用的密钥。部署到服务器时必须显式设置这一项（不要留空），
# 不然每次服务器重启生成的密钥都不一样，之前登录过的同事的加密数据会解不开，被迫重新登录。
# 本机生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Zoho OAuth（在 https://api-console.zoho.com 注册 Server-based Application 拿到）----
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REDIRECT_URI=https://你的网站域名/auth/zoho/callback
ZOHO_SCOPE=ZohoMail.accounts.READ,ZohoMail.messages.READ,ZohoMail.folders.READ

# ---- 数据库：不填就用本地 SQLite 文件（Render 免费实例磁盘不是持久化的，重新部署/重启可能会丢数据）----
# 建议部署到 Render 时用它的免费 PostgreSQL，把连接串填在这里：
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- 以下都是可选项，不填也能跑 ----

# 允许指定谁算"管理员"（逗号分隔邮箱）。不填的话默认第一个用 Zoho 登录的人是管理员。
# ADMIN_EMAILS=op003@tanzlogis.com

# 部署到有 https 的正式服务器后再打开，本机用 http 测试不要开。
# FORCE_HTTPS_COOKIES=1

# 只有需要看 Werkzeug 详细报错页排查问题时才打开，正式对外使用不要开（有安全风险）。
# FLASK_DEBUG=1

# Render 用 gunicorn 启动，不会用到下面这个；只有你本机直接 python app.py 时才会用。
# HOST=0.0.0.0

# ---- Microsoft OAuth（OneDrive 功能还在调试中，暂时不用填）----
# MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MS_REDIRECT_URI=https://你的网站域名/auth/microsoft/callback
